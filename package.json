{
  "name": "citizen-communication-templates",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist-helpers/* dist/",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/js/**/*.js",
    "format": "prettier --write \"src/js/**/*.js\" \"src/css/**/*.css\"",
    "electron:dev": "npm run build && electron .",
    "build:desktop:win": "npm run build && electron-builder --win --x64",
    "build:desktop:mac": "npm run build && electron-builder --mac zip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcheljd/citizen-communication-templates.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xcheljd/citizen-communication-templates/issues"
  },
  "homepage": "https://github.com/xcheljd/citizen-communication-templates#readme",
  "description": "Communication Template Generator desktop app",
  "devDependencies": {
    "@vitejs/plugin-legacy": "^7.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.0.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "com.citizen.communicationtemplates",
    "productName": "Communication Template Generator",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "zip"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
